{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concourse",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SITES": "[]"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "concourse",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
