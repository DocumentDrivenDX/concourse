{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:concourse:maintainer-requests:1.0.0",
  "title": "Concourse maintainer requests",
  "description": "Endpoint selects its named definition; root is the union, not operation dispatch.",
  "anyOf": [
    {
      "$ref": "#/$defs/feedbackQuery"
    },
    {
      "$ref": "#/$defs/discussionQuery"
    },
    {
      "$ref": "#/$defs/feedbackTriage"
    },
    {
      "$ref": "#/$defs/discussionReview"
    }
  ],
  "$defs": {
    "feedbackFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kinds": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "question",
              "problem",
              "suggestion"
            ]
          }
        },
        "statuses": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "new",
              "in_review",
              "closed"
            ]
          }
        },
        "createdFrom": {
          "type": "string",
          "format": "date-time"
        },
        "createdTo": {
          "type": "string",
          "format": "date-time"
        }
      },
      "dependentRequired": {
        "anchor": [
          "resource"
        ]
      }
    },
    "discussionFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "statuses": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "open",
              "resolved"
            ]
          }
        },
        "activityFrom": {
          "type": "string",
          "format": "date-time"
        },
        "activityTo": {
          "type": "string",
          "format": "date-time"
        }
      },
      "dependentRequired": {
        "anchor": [
          "resource"
        ]
      }
    },
    "feedbackQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "maxLength": 200,
          "default": ""
        },
        "filters": {
          "$ref": "#/$defs/feedbackFilters"
        },
        "sort": {
          "enum": [
            "newest",
            "oldest",
            "kind"
          ],
          "default": "newest"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "discussionQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "maxLength": 200,
          "default": ""
        },
        "filters": {
          "$ref": "#/$defs/discussionFilters"
        },
        "sort": {
          "enum": [
            "activity",
            "newest",
            "oldest"
          ],
          "default": "activity"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "feedbackTriage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "expectedVersion",
        "requestId"
      ],
      "properties": {
        "status": {
          "enum": [
            "new",
            "in_review",
            "closed"
          ]
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "discussionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "expectedVersion",
        "requestId",
        "expectedLatestContributionId"
      ],
      "properties": {
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "expectedLatestContributionId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
