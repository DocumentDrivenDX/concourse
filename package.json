{
  "name": "@novirhyza/concourse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check": "bun run typecheck && bun run lint && bun run check:boundaries && bun test tests && bun run build",
    "dev": "wrangler dev --local",
    "test:browser": "bun scripts/browser-test.ts",
    "lint": "biome lint src",
    "test:workerd": "node scripts/workerd-test.mjs",
    "build:browser": "bun scripts/build.ts --browser-only",
    "test:hugo-browser": "bun scripts/hugo-browser.ts"
  },
  "dependencies": {
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261029.1",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
